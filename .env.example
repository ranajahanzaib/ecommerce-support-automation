# Local API settings
# Docker Compose reads this file after it is copied to .env. Makefile-based
# development reads exported shell variables instead.
COMMERCEACTION_DB=./commerceaction.db
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=/api
# Fixture classification is the safe default. For a local Ollama OpenAI-compatible endpoint:
AI_PROVIDER=fixture
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=your-local-model
# For a hosted OpenAI-compatible endpoint, set AI_PROVIDER=openai-compatible and AI_API_KEY here.
# Never place provider secrets in the frontend environment.
